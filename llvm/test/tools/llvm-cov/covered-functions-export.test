// CHECK-NEXT: function-id - "f3" 0x0000000000000000
// CHECK:      coverage-body-at - "/mapped/b/f3.c" 1 11
// CHECK:      fragment - root "/mapped/b/f3.c" 1 1 100.00
// CHECK:      function - "f1"
// CHECK-NEXT: function-id - "f1" 0x0000000000000000
// CHECK:      coverage-body-at - "/mapped/f1.c" 1 11
// CHECK:      fragment - root "/mapped/f1.c" 1 1 100.00

