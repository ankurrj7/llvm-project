// OVERLAP-NEXT: expansion-at - "/tmp/ec/combine_expansions.cpp" 14 5 1 1 100.00
// OVERLAP-NEXT: region - 1 7 3 1
// OVERLAP-NEXT: end-expansion
// OVERLAP-NEXT: expansion-at - "/tmp/ec/combine_expansions.cpp" 14 5 1 1 100.00
// OVERLAP-NEXT: region - 1 7 3 1

// IDENTITY-NOT:   function - "use_
// IDENTITY:       function - "_ZL2f1v"
// IDENTITY-NEXT:  function-id - "use_1.cc:_ZL2f1v" 0x000000a38a3cf28e
// IDENTITY:       coverage-body-at - "/mapped/multiple_objects/header.h" 1 25
// IDENTITY:       fragment - root "/mapped/multiple_objects/header.h" 13 5 38.46
// IDENTITY-NOT:   function - "use_
// IDENTITY:       function - "_ZL2f1v"
// IDENTITY-NEXT:  function-id - "use_2.cc:_ZL2f1v" 0x0000000000000000
// IDENTITY:       coverage-body-at - "/mapped/multiple_objects/header.h" 1 25
// IDENTITY:       fragment - root "/mapped/multiple_objects/header.h" 1 1 100.00
// IDENTITY-NOT:   function - "use_

// FRAGMENTS:      function - "covered"
// FRAGMENTS-NEXT: function-id - "covered" 0x000000000001835c
// FRAGMENTS-NEXT: entry-count - 1
// FRAGMENTS-NEXT: overall-coverage - 5 4 80.00
// FRAGMENTS-NEXT: coverage-body-at - "/tmp/covered-functions-fragment/covered-functions-fragment.c" 3 20
// FRAGMENTS-NEXT: fragment - root "/tmp/covered-functions-fragment/covered-functions-fragment.c" 1 1 100.00
