// CHECK:      covered-functions-format 3
// CHECK-NEXT: mode - execution
// CHECK-NEXT: features - branches=0 mcdc=0
// CHECK:      function - "f2"
// CHECK-NEXT: function-id - "f2" 0x0000000000000000
// CHECK-NEXT: entry-count - 1
// CHECK-NEXT: overall-coverage - 1 1 100.00
// CHECK-NEXT: coverage-body-at - "/mapped/a/f2.c" 1 11
// CHECK-NEXT: fragment - root "/mapped/a/f2.c" 1 1 100.00
// CHECK-NEXT: region - 1 1 11 1 13 1
// CHECK-NEXT: end-fragment
// CHECK-NEXT: end-function
// CHECK:      function - "f4"
// CHECK-NEXT: function-id - "f4" 0x0000000000000000
// CHECK:      coverage-body-at - "/mapped/b/c/f4.c" 1 11
